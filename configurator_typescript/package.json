{
  "name": "configurator-typescript",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-safe TypeScript runtime for generated Configurator scopes",
  "keywords": [
    "configuration",
    "feature-flags",
    "typescript",
    "yaml"
  ],
  "homepage": "https://github.com/camrongiuliani/configurator#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/camrongiuliani/configurator.git",
    "directory": "configurator_typescript"
  },
  "bugs": {
    "url": "https://github.com/camrongiuliani/configurator/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "compile": "tsc --project tsconfig.json",
    "test": "npm run compile && node --test test/*.test.js",
    "prepack": "npm test"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  },
  "license": "UNLICENSED"
}
